<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:FrameFileTool.Models"
                    xmlns:previews="clr-namespace:FrameFileTool.ViewModels.Previews">

<!-- 共用 DataGrid 樣式 -->
<Style x:Key="PreviewDataGrid" TargetType="DataGrid"
       BasedOn="{StaticResource {x:Type DataGrid}}">
    <Setter Property="AutoGenerateColumns"  Value="False" />
    <Setter Property="IsReadOnly"           Value="False" />
    <Setter Property="CanUserAddRows"       Value="False" />
    <Setter Property="CanUserDeleteRows"    Value="False" />
    <Setter Property="GridLinesVisibility"  Value="Horizontal" />
    <Setter Property="HeadersVisibility"    Value="Column" />
    <Setter Property="SelectionMode"        Value="Single" />
    <Setter Property="BorderThickness"      Value="0" />
    <Setter Property="RowBackground"        Value="White" />
    <Setter Property="ColumnHeaderStyle"    Value="{DynamicResource TableColumnHeader}" />
    <Setter Property="AutomationProperties.Name" Value="預覽結果表格" />
    <Setter Property="EnableRowVirtualization" Value="True" />
    <Setter Property="EnableColumnVirtualization" Value="True" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
</Style>

<!-- 共用 DataGridRow Style（未納入列淡灰底；錯誤列淡紅底） -->
<Style x:Key="PreviewRowStyle" TargetType="DataGridRow">
    <Setter Property="ToolTip"                   Value="{Binding Status}" />
    <Setter Property="ToolTipService.IsEnabled"  Value="False" />
    <Style.Triggers>
        <DataTrigger Binding="{Binding IsIncluded}" Value="False">
            <Setter Property="Background"                Value="#F8FAFC" />
            <Setter Property="Foreground"                Value="{DynamicResource TextMuted}" />
            <Setter Property="Opacity"                   Value="0.68" />
        </DataTrigger>
        <DataTrigger Binding="{Binding HasDisplayError}" Value="True">
            <Setter Property="Background"                Value="#FEF2F2" />
            <Setter Property="Foreground"                Value="{DynamicResource TextPrimary}" />
            <Setter Property="Opacity"                   Value="1" />
            <Setter Property="ToolTipService.IsEnabled"  Value="True" />
        </DataTrigger>
    </Style.Triggers>
</Style>

<!-- ── 抽幀刪除 DataTemplate：# | 原始檔名/行為 | 目標 ── -->
<DataTemplate DataType="{x:Type previews:FrameDeletePreviewViewModel}">
    <DataGrid ItemsSource="{Binding Items}"
              Style="{StaticResource PreviewDataGrid}"
              RowStyle="{StaticResource PreviewRowStyle}">
        <DataGrid.Columns>
            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="48" IsReadOnly="True" />
            <DataGridTemplateColumn Header="納入" Width="56">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <CheckBox HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  AutomationProperties.Name="納入執行">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="動作 / 原始檔名" Width="3*">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left"
                                        MinWidth="44"
                                        Margin="0,0,8,0"
                                        Padding="7,2"
                                        CornerRadius="6"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F1F5F9" />
                                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActionKind}" Value="{x:Static models:OperationActionKind.Delete}">
                                                    <Setter Property="Background" Value="#FEE2E2" />
                                                    <Setter Property="BorderBrush" Value="#FCA5A5" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActionKind}" Value="{x:Static models:OperationActionKind.Copy}">
                                                    <Setter Property="Background" Value="#DBEAFE" />
                                                    <Setter Property="BorderBrush" Value="#93C5FD" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActionKind}" Value="{x:Static models:OperationActionKind.Error}">
                                                    <Setter Property="Background" Value="#FEF3C7" />
                                                    <Setter Property="BorderBrush" Value="#FBBF24" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Action}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActionKind}" Value="{x:Static models:OperationActionKind.Delete}">
                                                        <Setter Property="Foreground" Value="#B91C1C" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ActionKind}" Value="{x:Static models:OperationActionKind.Copy}">
                                                        <Setter Property="Foreground" Value="#1D4ED8" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ActionKind}" Value="{x:Static models:OperationActionKind.Error}">
                                                        <Setter Property="Foreground" Value="#B45309" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding OriginalName}"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding OriginalName}" />
                            </DockPanel>
                            <TextBlock Text="{Binding Status}"
                                       Margin="52,4,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Status}" />
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="目標" Width="2*">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock VerticalAlignment="Center">
                            <TextBlock.ToolTip>
                                <Binding Path="TargetName" />
                            </TextBlock.ToolTip>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text"      Value="{Binding TargetName}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActionKind}" Value="{x:Static models:OperationActionKind.Keep}">
                                            <Setter Property="Text"      Value="不變更" />
                                            <Setter Property="Foreground" Value="#94A3B8" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActionKind}" Value="{x:Static models:OperationActionKind.Delete}">
                                            <Setter Property="Foreground" Value="#DC2626" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActionKind}" Value="{x:Static models:OperationActionKind.Copy}">
                                            <Setter Property="Foreground" Value="#2563EB" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Width="56" Header="剔除">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Button Content="剔除"
                                Padding="4,2"
                                FontSize="11"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#EF4444"
                                Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="剔除此檔案" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>
    </DataGrid>
</DataTemplate>

