<Window x:Class="FrameFileTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FrameFileTool"
        Width="1200"
        Height="800"
        MinWidth="1000"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,4" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 欄位標籤：置於 TextBox 上方 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,2" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="FontSize" Value="12" />
        </Style>

    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="160" />
        </Grid.RowDefinitions>

        <!-- ── 資料夾列 ───────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="資料夾" FontWeight="SemiBold" Margin="0,0,8,0" />

            <TextBox Grid.Column="1"
                     Text="{Binding SelectedFolder, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="2"
                    Content="選擇資料夾"
                    Margin="8,0,4,0"
                    Command="{Binding BrowseFolderCommand}" />

            <Button Grid.Column="3"
                    Content="重新掃描"
                    Command="{Binding ScanCommand}" />
        </Grid>

        <!-- ── 篩選列 ─────────────────────────────────────────── -->
        <Border Grid.Row="1"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,1"
                Padding="0,8"
                Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <TextBlock Text="副檔名" FontWeight="SemiBold" Margin="0,0,8,0" />
                <CheckBox Content=".png"  IsChecked="{Binding IncludePng}" />
                <CheckBox Content=".jpg"  IsChecked="{Binding IncludeJpg}" />
                <CheckBox Content=".jpeg" IsChecked="{Binding IncludeJpeg}" />
                <CheckBox Content=".webp" IsChecked="{Binding IncludeWebp}" />
                <CheckBox Content=".bmp"  IsChecked="{Binding IncludeBmp}" />
                <CheckBox Content="包含子資料夾"
                          IsChecked="{Binding IncludeSubfolders}"
                          Margin="24,0,6,0" />
                <TextBlock Text="{Binding FileSummary}"
                           Margin="24,0,0,0"
                           Foreground="#6B7280"
                           FontStyle="Italic" />
            </DockPanel>
        </Border>

        <!-- ── 主內容：工具面板 + 預覽表格 ───────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左側工具面板 -->
            <TabControl Grid.Column="0"
                        SelectedIndex="{Binding SelectedToolIndex}">

                <TabItem Header="抽幀刪除">
                    <StackPanel Margin="12">
                        <TextBlock Text="每 N 張刪除 1 張"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="間隔 N" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding FrameDeleteInterval, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="N = 3：刪除第 3、6、9… 張。"
                                   TextWrapping="Wrap"
                                   Foreground="#6B7280"
                                   FontSize="11"
                                   Margin="0,0,0,12" />

                        <Button Content="① 預覽抽幀"
                                Command="{Binding PreviewFrameDeleteCommand}"
                                HorizontalAlignment="Stretch" />

                        <Button Content="② 執行刪除"
                                Command="{Binding ExecuteFrameDeleteCommand}"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="批次改名">
                    <StackPanel Margin="12">
                        <TextBlock Text="批次改名"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="前綴" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding RenamePrefix, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="起始編號" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding RenameStartIndex, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="補零位數（0 = 不補零）" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding RenamePadding, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Content="① 預覽改名"
                                Command="{Binding PreviewRenameCommand}"
                                HorizontalAlignment="Stretch"
                                Margin="0,12,0,0" />

                        <Button Content="② 執行改名"
                                Command="{Binding ExecuteRenameCommand}"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>
                </TabItem>

            </TabControl>

            <!-- 右側預覽區 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 預覽摘要列 -->
                <Border Grid.Row="0"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="10,6"
                        Margin="0,0,0,6">
                    <TextBlock Text="{Binding PreviewSummary}"
                               Foreground="#374151"
                               FontSize="12" />
                </Border>

                <!-- 預覽表格 -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding PreviewItems}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          SelectionMode="Single">

                    <!-- 有錯誤的列顯示淡紅底色 -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Background" Value="#FEF2F2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="#"
                                            Binding="{Binding Index}"
                                            Width="50" />

                        <DataGridTextColumn Header="原始檔名"
                                            Binding="{Binding OriginalName}"
                                            Width="2*" />

                        <!-- 動作欄：刪除 → 紅色、保留 → 灰色 -->
                        <DataGridTextColumn Header="動作"
                                            Binding="{Binding Action}"
                                            Width="72">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="刪除">
                                            <Setter Property="Foreground" Value="#DC2626" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                        <Trigger Property="Text" Value="保留">
                                            <Setter Property="Foreground" Value="#9CA3AF" />
                                        </Trigger>
                                        <Trigger Property="Text" Value="錯誤">
                                            <Setter Property="Foreground" Value="#D97706" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="目標 / 說明"
                                            Binding="{Binding TargetName}"
                                            Width="2*" />

                        <!-- 狀態欄：有錯誤時顯示紅色加粗 -->
                        <DataGridTextColumn Header="狀態"
                                            Binding="{Binding Status}"
                                            Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Foreground" Value="#DC2626" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- ── Log ───────────────────────────────────────────── -->
        <GroupBox Grid.Row="3"
                  Header="Log"
                  Margin="0,8,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="清除"
                        Command="{Binding ClearLogCommand}"
                        Width="72"
                        VerticalAlignment="Top"
                        Margin="8,4,0,0" />
                <ListBox ItemsSource="{Binding Logs}"
                         FontFamily="Consolas"
                         FontSize="11" />
            </DockPanel>
        </GroupBox>

    </Grid>
</Window>
