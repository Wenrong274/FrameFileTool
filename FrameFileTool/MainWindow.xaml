<Window x:Class="FrameFileTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:FrameFileTool.Models"
        Title="影格整理工具"
        Icon="Assets/AppIcon.ico"
        Background="#EEF2F7"
        FontFamily="Segoe UI"
        Width="1240"
        Height="800"
        MinWidth="1000"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>

        <!-- ── 色票 ────────────────────────────────────────────── -->
        <SolidColorBrush x:Key="AccentBrush"         Color="#2563EB" />
        <SolidColorBrush x:Key="AccentHoverBrush"    Color="#1D4ED8" />
        <SolidColorBrush x:Key="AccentDisabledBrush" Color="#BFDBFE" />
        <SolidColorBrush x:Key="DangerBrush"         Color="#DC2626" />
        <SolidColorBrush x:Key="DangerHoverBrush"    Color="#B91C1C" />
        <SolidColorBrush x:Key="DangerDisabledBrush" Color="#FCA5A5" />
        <SolidColorBrush x:Key="SurfaceBrush"        Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceSubtleBrush"  Color="#F8FAFC" />
        <SolidColorBrush x:Key="CardBorderBrush"     Color="#DDE5F0" />
        <SolidColorBrush x:Key="GhostBorderBrush"    Color="#CBD5E1" />
        <SolidColorBrush x:Key="InputFocusBrush"     Color="#93C5FD" />
        <SolidColorBrush x:Key="TextPrimary"         Color="#0F172A" />
        <SolidColorBrush x:Key="TextSecondary"       Color="#64748B" />
        <SolidColorBrush x:Key="TextMuted"           Color="#94A3B8" />
        <SolidColorBrush x:Key="HeaderBrush"         Color="#EAF0F7" />

        <!-- ── Button：ghost（預設，用於選擇資料夾等次要動作）─── -->
        <Style TargetType="Button">
            <Setter Property="Height"          Value="34" />
            <Setter Property="Padding"         Value="14,0" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Foreground"      Value="{StaticResource TextPrimary}" />
            <Setter Property="Background"      Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush"     Value="{StaticResource GhostBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize"        Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"  Value="#F8FAFC" />
                                <Setter Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"  Value="#94A3B8" />
                                <Setter Property="BorderBrush" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Button：primary 藍色（預覽動作）────────────────── -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height"          Value="34" />
            <Setter Property="Padding"         Value="14,0" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Foreground"      Value="White" />
            <Setter Property="Background"      Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="FontSize"        Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{StaticResource AccentDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Button：execute 紅色（執行破壞性動作）───────────── -->
        <Style x:Key="ExecuteButton" TargetType="Button">
            <Setter Property="Height"          Value="34" />
            <Setter Property="Padding"         Value="14,0" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Foreground"      Value="White" />
            <Setter Property="Background"      Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="FontSize"        Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource DangerHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{StaticResource DangerDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TextBox ───────────────────────────────────────── -->
        <Style TargetType="TextBox">
            <Setter Property="Height"                   Value="32" />
            <Setter Property="Padding"                  Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush"              Value="{StaticResource GhostBorderBrush}" />
            <Setter Property="BorderThickness"          Value="1" />
            <Setter Property="Background"               Value="White" />
            <Setter Property="Margin"                   Value="0,2,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="{StaticResource InputFocusBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── CheckBox ──────────────────────────────────────── -->
        <Style TargetType="CheckBox">
            <Setter Property="Margin"            Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ── 副檔名 toggle：比原生 checkbox 更適合密集工具列 ── -->
        <Style x:Key="PillCheckBox" TargetType="CheckBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Pill"
                                Background="{StaticResource SurfaceSubtleBrush}"
                                BorderBrush="{StaticResource GhostBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="15"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#EAF2FF" />
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TextBlock（全域）──────────────────────────────── -->
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground"        Value="{StaticResource TextPrimary}" />
        </Style>

        <!-- ── 欄位標籤（TextBox 上方）───────────────────────── -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11" />
            <Setter Property="Margin"     Value="0,8,0,2" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>

        <!-- ── 區塊標題 ──────────────────────────────────────── -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin"     Value="0,0,0,10" />
        </Style>

        <!-- ── 提示說明文字 ───────────────────────────────────── -->
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11" />
            <Setter Property="Foreground"   Value="{StaticResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin"       Value="0,0,0,12" />
        </Style>

        <!-- ── Card 容器 ─────────────────────────────────────── -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush"     Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="8" />
        </Style>

        <!-- ── Tab：工具切換 ─────────────────────────────────── -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Margin" Value="0,0,6,10" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#EAF2FF" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataGrid ──────────────────────────────────────── -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceSubtleBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF2F7" />
            <Setter Property="RowHeight" Value="46" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TableColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="{StaticResource HeaderBrush}" />
            <Setter Property="Foreground"      Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize"        Value="11" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="Padding"         Value="10,8" />
            <Setter Property="BorderBrush"     Value="#DDE5F0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="SeparatorVisibility" Value="Collapsed" />
        </Style>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="170" />
        </Grid.RowDefinitions>

        <!-- ── 頁首：產品識別與當前狀態 ─────────────────────── -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Padding="14,10"
                Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <Image DockPanel.Dock="Left"
                       Source="Assets/AppIcon.png"
                       Width="34"
                       Height="34"
                       Margin="0,0,12,0" />

                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding FileSummary}"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12"
                           Margin="16,0,0,0" />

                <StackPanel>
                    <TextBlock Text="影格整理工具"
                               FontSize="17"
                               FontWeight="SemiBold" />
                    <TextBlock Text="FrameFileTool：序列圖片抽幀刪除與批次改名工具"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12"
                               Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── 來源設定：資料夾與掃描選項集中在同一區 ───────── -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Padding="14,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Text="來源資料夾"
                           FontWeight="SemiBold"
                           Margin="0,0,10,0" />

                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Margin="0,0,8,0"
                         Text="{Binding SelectedFolder, UpdateSourceTrigger=PropertyChanged}" />

                <Button Grid.Row="0"
                        Grid.Column="2"
                        Content="選擇資料夾"
                        Margin="0,0,6,0"
                        Command="{Binding BrowseFolderCommand}" />

                <Button Grid.Row="0"
                        Grid.Column="3"
                        Content="重新掃描"
                        Command="{Binding ScanFilesCommand}" />

                <TextBlock Grid.Row="1"
                           Text="掃描格式"
                           FontWeight="SemiBold"
                           Margin="0,8,10,0" />

                <WrapPanel Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="3"
                           Margin="0,8,0,0"
                           VerticalAlignment="Center">
                    <CheckBox Content=".png"
                              Style="{StaticResource PillCheckBox}"
                              IsChecked="{Binding IncludePng}" />
                    <CheckBox Content=".jpg"
                              Style="{StaticResource PillCheckBox}"
                              IsChecked="{Binding IncludeJpg}" />
                    <CheckBox Content=".jpeg"
                              Style="{StaticResource PillCheckBox}"
                              IsChecked="{Binding IncludeJpeg}" />
                    <CheckBox Content=".webp"
                              Style="{StaticResource PillCheckBox}"
                              IsChecked="{Binding IncludeWebp}" />
                    <CheckBox Content=".bmp"
                              Style="{StaticResource PillCheckBox}"
                              IsChecked="{Binding IncludeBmp}" />
                    <CheckBox Content="包含子資料夾"
                              Style="{StaticResource PillCheckBox}"
                              MinWidth="110"
                              IsChecked="{Binding IncludeSubfolders}" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ── 主內容：左側工具 + 右側預覽 ─────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左側：操作面板 -->
            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="0"
                    ClipToBounds="True">
                <TabControl SelectedIndex="{Binding SelectedToolIndex}"
                            BorderThickness="0"
                            Background="Transparent">

                    <TabItem Header="抽幀刪除" Margin="0,0,6,1">
                        <StackPanel Margin="14,12">

                            <TextBlock Text="抽幀刪除"
                                       Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="間隔 N"
                                       Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding FrameDeleteInterval, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="N = 3 時，刪除排序後第 3、6、9… 張。"
                                       Style="{StaticResource HintText}" />

                            <Button Content="預覽抽幀"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding PreviewFrameDeleteCommand}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,6" />

                            <Button Content="執行刪除（移至回收桶）"
                                    Style="{StaticResource ExecuteButton}"
                                    Command="{Binding ExecuteFrameDeleteCommand}"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="批次改名" Margin="0,0,6,1">
                        <StackPanel Margin="14,12">

                            <TextBlock Text="批次改名"
                                       Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="前綴"
                                       Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding RenamePrefix, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="起始編號"
                                       Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding RenameStartIndex, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="補零位數（0 = 不補零）"
                                       Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding RenamePadding, UpdateSourceTrigger=PropertyChanged}" />

                            <Button Content="預覽改名"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding PreviewRenameCommand}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,12,0,6" />

                            <Button Content="執行改名"
                                    Style="{StaticResource ExecuteButton}"
                                    Command="{Binding ExecuteRenameCommand}"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </TabItem>

                </TabControl>
            </Border>

            <!-- 右側：預覽區 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 預覽摘要列：idle=灰 / ok=綠 / error=紅 -->
                <Border Grid.Row="0"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,7"
                        Margin="0,0,0,6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"  Value="#F8FAFC" />
                            <Setter Property="BorderBrush" Value="#E2E8F0" />
                            <Style.Triggers>
                                <!-- 有預覽且無錯誤：綠色 -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasPreview}"       Value="True" />
                                        <Condition Binding="{Binding HasPreviewErrors}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background"  Value="#F0FDF4" />
                                    <Setter Property="BorderBrush" Value="#86EFAC" />
                                </MultiDataTrigger>
                                <!-- 有錯誤：紅色 -->
                                <DataTrigger Binding="{Binding HasPreviewErrors}" Value="True">
                                    <Setter Property="Background"  Value="#FEF2F2" />
                                    <Setter Property="BorderBrush" Value="#FECACA" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock Text="{Binding PreviewSummary}" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasPreview}"       Value="True" />
                                            <Condition Binding="{Binding HasPreviewErrors}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="#166534" />
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding HasPreviewErrors}" Value="True">
                                        <Setter Property="Foreground" Value="#991B1B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- 預覽表格 -->
                <Border Grid.Row="1"
                        Style="{StaticResource Card}"
                        ClipToBounds="True"
                        Padding="0">
                    <DataGrid ItemsSource="{Binding PreviewItems}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              BorderThickness="0"
                              RowBackground="White"
                              ColumnHeaderStyle="{StaticResource TableColumnHeader}">

                        <!-- 有錯誤的列：淡紅底 -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip" Value="{Binding Status}" />
                                <Setter Property="ToolTipService.IsEnabled" Value="False" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Background" Value="#FEF2F2" />
                                        <Setter Property="ToolTipService.IsEnabled" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="#"
                                                Binding="{Binding Index}"
                                                Width="48" />

                            <!-- 原始檔名與動作合併：保留順序欄，讓動作成為掃描時第一眼可見的訊號。 -->
                            <DataGridTemplateColumn Header="原始檔名 / 行為"
                                                    Width="3*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Width="26"
                                                       FontFamily="Segoe UI Emoji"
                                                       FontSize="15"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="－" />
                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Action}"
                                                                         Value="{x:Static models:OperationAction.Delete}">
                                                                <Setter Property="Text" Value="❌" />
                                                                <Setter Property="Foreground" Value="#DC2626" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}"
                                                                         Value="{x:Static models:OperationAction.Rename}">
                                                                <Setter Property="Text" Value="✨" />
                                                                <Setter Property="Foreground" Value="#2563EB" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}"
                                                                         Value="{x:Static models:OperationAction.Error}">
                                                                <Setter Property="Text" Value="⚠" />
                                                                <Setter Property="Foreground" Value="#D97706" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <StackPanel>
                                                <TextBlock Text="{Binding OriginalName}"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Action}"
                                                           FontSize="11"
                                                           Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#94A3B8" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Action}"
                                                                             Value="{x:Static models:OperationAction.Delete}">
                                                                    <Setter Property="Foreground" Value="#DC2626" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Action}"
                                                                             Value="{x:Static models:OperationAction.Rename}">
                                                                    <Setter Property="Foreground" Value="#2563EB" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Action}"
                                                                             Value="{x:Static models:OperationAction.Error}">
                                                                    <Setter Property="Foreground" Value="#D97706" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="目標"
                                                    Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding TargetName}" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Action}"
                                                                     Value="{x:Static models:OperationAction.Keep}">
                                                            <Setter Property="Text" Value="不變更" />
                                                            <Setter Property="Foreground" Value="#94A3B8" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}"
                                                                     Value="{x:Static models:OperationAction.Delete}">
                                                            <Setter Property="Foreground" Value="#DC2626" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <!-- ── Log（深色面板）────────────────────────────────── -->
        <Border Grid.Row="3"
                Background="#1E293B"
                CornerRadius="6"
                Margin="0,10,0,0"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Log 標題列 -->
                <DockPanel Grid.Row="0"
                           Background="#0F172A"
                           LastChildFill="False">
                    <TextBlock Text="LOG"
                               Foreground="#64748B"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="12,6" />
                    <Button DockPanel.Dock="Right"
                            Content="清除"
                            Command="{Binding ClearLogCommand}"
                            Height="22"
                            Padding="10,0"
                            Margin="6,4"
                            FontSize="11"
                            Foreground="#94A3B8"
                            Background="Transparent"
                            BorderBrush="#334155"
                            BorderThickness="1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="3"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background"  Value="#1E293B" />
                                        <Setter Property="BorderBrush" Value="#64748B" />
                                        <Setter Property="Foreground"  Value="#CBD5E1" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DockPanel>

                <!-- Log 訊息清單 -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Logs}"
                         Background="Transparent"
                         BorderThickness="0"
                         FontFamily="Cascadia Code, Consolas, monospace"
                         FontSize="11"
                         Foreground="#94A3B8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background"       Value="Transparent" />
                            <Setter Property="BorderThickness"  Value="0" />
                            <Setter Property="Padding"          Value="12,1" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

    </Grid>
</Window>
