<Window x:Class="FrameFileTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="影格整理工具"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Background="#EEF2F7"
        FontFamily="Segoe UI"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/MainWindowStyles.xaml" />
                <ResourceDictionary Source="Resources/PreviewTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── 頁首：產品識別 ─────────────────────────────────── -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Padding="12,8"
                Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <Image DockPanel.Dock="Left"
                       Source="pack://application:,,,/Assets/AppIcon.png"
                       Width="28"
                       Height="28"
                       Margin="0,0,10,0" />

                <TextBlock Text="影格整理工具"
                           FontSize="17"
                           FontWeight="SemiBold" />
            </DockPanel>
        </Border>

        <!-- ── 更新通知：啟動後背景檢查 GitHub Release ─────── -->
        <Border Grid.Row="1"
                Background="#EFF6FF"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,0,0,10"
                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="關閉"
                        Command="{Binding DismissUpdateBannerCommand}"
                        Height="28"
                        Padding="10,0"
                        Margin="8,0,0,0"
                        FontSize="11"
                        Foreground="{StaticResource TextSecondary}"
                        Background="White"
                        BorderBrush="{StaticResource GhostBorderBrush}" />

                <Button DockPanel.Dock="Right"
                        Content="下載更新"
                        Command="{Binding GoToDownloadPageCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Height="28"
                        Padding="12,0"
                        FontSize="11" />

                <TextBlock Foreground="#1E3A8A"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis">
                    <Run Text="已有新版可下載：" />
                    <Run Text="{Binding LatestVersionText}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- ── 來源設定：資料夾與掃描選項集中在同一區 ───────── -->
        <Border Grid.Row="3"
                Style="{StaticResource Card}"
                Padding="12,10"
                Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Text="來源資料夾"
                           FontWeight="SemiBold"
                           Margin="0,0,10,0" />

                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Margin="0,0,8,0"
                         Text="{Binding SelectedFolder, UpdateSourceTrigger=PropertyChanged}" />

                <Button Grid.Row="0"
                        Grid.Column="2"
                        Content="選擇資料夾"
                        Margin="0,0,6,0"
                        Command="{Binding BrowseFolderCommand}" />

                <Button Grid.Row="0"
                        Grid.Column="3"
                        Content="重新掃描"
                        Command="{Binding ScanFilesCommand}" />

                <Button Grid.Row="0"
                        Grid.Column="4"
                        Content="清空全部"
                        Margin="6,0,0,0"
                        Command="{Binding ClearFolderAndFilesCommand}" />

                <TextBlock Grid.Row="0"
                           Grid.Column="5"
                           Text="{Binding FileSummary}"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12"
                           Margin="14,0,0,0" />

                <TextBlock Grid.Row="1"
                           Text="掃描格式"
                           FontWeight="SemiBold"
                           Margin="0,8,10,0" />

                <WrapPanel Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="5"
                           Margin="0,8,0,0"
                           VerticalAlignment="Center">
                    <CheckBox Content=".png"
                              Style="{StaticResource PillCheckBox}"
                              IsChecked="{Binding IncludePng}" />
                    <CheckBox Content=".jpg"
                              Style="{StaticResource PillCheckBox}"
                              IsChecked="{Binding IncludeJpg}" />
                    <CheckBox Content=".jpeg"
                              Style="{StaticResource PillCheckBox}"
                              IsChecked="{Binding IncludeJpeg}" />
                    <CheckBox Content=".webp"
                              Style="{StaticResource PillCheckBox}"
                              IsChecked="{Binding IncludeWebp}" />
                    <CheckBox Content=".bmp"
                              Style="{StaticResource PillCheckBox}"
                              IsChecked="{Binding IncludeBmp}" />
                    <CheckBox Content="包含子資料夾"
                              Style="{StaticResource PillCheckBox}"
                              MinWidth="110"
                              IsChecked="{Binding IncludeSubfolders}" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ── 主內容：全寬 TabControl，每個 TabItem 維持左右分欄 ── -->
        <TabControl Grid.Row="2"
                    SelectedIndex="{Binding SelectedToolIndex, Mode=TwoWay}"
                    Style="{StaticResource ToolTabControl}">

            <!-- ── 抽幀刪除 ─────────────────────────────────── -->
            <TabItem Header="抽幀刪除"
                     Style="{StaticResource ToolTabItem}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource Card}"
                            Padding="0"
                            ClipToBounds="True">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12,10"
                                        DataContext="{Binding FrameDeleteTool}"
                                        Grid.IsSharedSizeScope="True">

                                <!-- 間隔 -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="間隔"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,8,0"
                                               Grid.Column="0" />
                                    <TextBox Grid.Column="1"
                                             Margin="0"
                                             Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <TextBlock Text="刪除會移至回收桶"
                                           Style="{StaticResource HintText}"
                                           Margin="0,0,0,6" />

                                <TextBlock Text="輸出模式"
                                           Style="{StaticResource FieldLabel}" />
                                <StackPanel Margin="0,2,0,4">
                                    <RadioButton Content="移到回收桶"
                                                 GroupName="FrameDeleteOutputMode"
                                                 Margin="0,0,0,4"
                                                 IsChecked="{Binding OutputMode,
                                                     Converter={StaticResource EnumToBoolConverter},
                                                     ConverterParameter=DeleteToRecycleBin}" />
                                    <RadioButton Content="複製保留幀到指定資料夾"
                                                 GroupName="FrameDeleteOutputMode"
                                                 IsChecked="{Binding OutputMode,
                                                     Converter={StaticResource EnumToBoolConverter},
                                                     ConverterParameter=CopyKeptToTargetFolder}" />
                                </StackPanel>

                                <TextBlock Text="* 預覽不含目標資料夾衝突偵測，將於執行時選擇資料夾並重新確認"
                                           Style="{StaticResource HintText}"
                                           Margin="0,0,0,4"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding OutputMode,
                                               Converter={StaticResource EnumToVisibilityConverter},
                                               ConverterParameter=CopyKeptToTargetFolder}" />

                                <Button Content="{Binding ExecuteButtonText}"
                                        Style="{StaticResource ExecuteButton}"
                                        Command="{Binding ExecuteCommand}"
                                        HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- 右側：預覽區 -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 預覽摘要列：idle=灰 / ok=綠 / error=紅 -->
                        <Border Grid.Row="0"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="12,7"
                                Margin="0,0,0,6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background"  Value="#F8FAFC" />
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Style.Triggers>
                                        <!-- 有預覽且無錯誤：綠色 -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasPreview}"       Value="True" />
                                                <Condition Binding="{Binding HasPreviewErrors}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background"  Value="#F0FDF4" />
                                            <Setter Property="BorderBrush" Value="#86EFAC" />
                                        </MultiDataTrigger>
                                        <!-- 有錯誤：紅色 -->
                                        <DataTrigger Binding="{Binding HasPreviewErrors}" Value="True">
                                            <Setter Property="Background"  Value="#FEF2F2" />
                                            <Setter Property="BorderBrush" Value="#FECACA" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <TextBlock Text="{Binding PreviewSummary}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasPreview}"       Value="True" />
                                                    <Condition Binding="{Binding HasPreviewErrors}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="#166534" />
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding HasPreviewErrors}" Value="True">
                                                <Setter Property="Foreground" Value="#991B1B" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- 預覽表格：ContentControl 依 CurrentPreview 型別自動選擇 DataTemplate -->
                        <Border Grid.Row="1"
                                Style="{StaticResource Card}"
                                AllowDrop="True"
                                DragEnter="PreviewDropTarget_DragEnter"
                                DragOver="PreviewDropTarget_DragOver"
                                DragLeave="PreviewDropTarget_DragLeave"
                                Drop="PreviewDropTarget_Drop"
                                ClipToBounds="True"
                                Padding="0">
                            <Grid>
                                <ContentControl Content="{Binding CurrentPreview}"
                                                AutomationProperties.Name="操作預覽"
                                                Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                                </ContentControl>

                                <Border Padding="18">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="尚未產生預覽"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="載入圖片後將自動顯示預覽"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,6,0,0"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border IsHitTestVisible="False"
                                        Background="#EEF6FF"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="2"
                                        Visibility="{Binding IsPreviewDropTargetActive, Converter={StaticResource BoolToVis}}">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="放開以新增資料"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="支援拖曳檔案或資料夾"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,6,0,0"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ── 批次改名 ─────────────────────────────────── -->
            <TabItem Header="批次改名"
                     Style="{StaticResource ToolTabItem}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource Card}"
                            Padding="0"
                            ClipToBounds="True">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12,10"
                                        DataContext="{Binding RenameTool}"
                                        Grid.IsSharedSizeScope="True">

                                <!-- 前綴 -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="前綴"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,8,0"
                                               Grid.Column="0" />
                                    <TextBox Grid.Column="1"
                                             Margin="0"
                                             Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <!-- 起始編號 -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="起始編號"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,8,0"
                                               Grid.Column="0" />
                                    <TextBox Grid.Column="1"
                                             Margin="0"
                                             Text="{Binding StartIndex, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <!-- 補零位數 -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="補零位數"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,8,0"
                                               Grid.Column="0"
                                               ToolTip="輸入 0 時不補零" />
                                    <TextBox Grid.Column="1"
                                             Margin="0"
                                             Text="{Binding ZeroPadding, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="輸入 0 時不補零" />
                                </Grid>

                                <TextBlock Text="輸出模式"
                                           Style="{StaticResource FieldLabel}" />
                                <StackPanel Margin="0,2,0,4">
                                    <RadioButton Content="原地改名"
                                                 GroupName="RenameOutputMode"
                                                 Margin="0,0,0,4"
                                                 IsChecked="{Binding OutputMode,
                                                     Converter={StaticResource EnumToBoolConverter},
                                                     ConverterParameter=RenameInPlace}" />
                                    <RadioButton Content="複製改名到指定資料夾"
                                                 GroupName="RenameOutputMode"
                                                 IsChecked="{Binding OutputMode,
                                                     Converter={StaticResource EnumToBoolConverter},
                                                     ConverterParameter=CopyToTargetFolder}" />
                                </StackPanel>

                                <TextBlock Text="* 預覽不含目標資料夾衝突偵測，將於執行時選擇資料夾並重新確認"
                                           Style="{StaticResource HintText}"
                                           Margin="0,0,0,4"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding OutputMode,
                                               Converter={StaticResource EnumToVisibilityConverter},
                                               ConverterParameter=CopyToTargetFolder}" />

                                <Button Content="{Binding ExecuteButtonText}"
                                        Style="{StaticResource ExecuteButton}"
                                        Command="{Binding ExecuteCommand}"
                                        HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- 右側：預覽區 -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 預覽摘要列：idle=灰 / ok=綠 / error=紅 -->
                        <Border Grid.Row="0"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="12,7"
                                Margin="0,0,0,6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background"  Value="#F8FAFC" />
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Style.Triggers>
                                        <!-- 有預覽且無錯誤：綠色 -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasPreview}"       Value="True" />
                                                <Condition Binding="{Binding HasPreviewErrors}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background"  Value="#F0FDF4" />
                                            <Setter Property="BorderBrush" Value="#86EFAC" />
                                        </MultiDataTrigger>
                                        <!-- 有錯誤：紅色 -->
                                        <DataTrigger Binding="{Binding HasPreviewErrors}" Value="True">
                                            <Setter Property="Background"  Value="#FEF2F2" />
                                            <Setter Property="BorderBrush" Value="#FECACA" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <TextBlock Text="{Binding PreviewSummary}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasPreview}"       Value="True" />
                                                    <Condition Binding="{Binding HasPreviewErrors}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="#166534" />
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding HasPreviewErrors}" Value="True">
                                                <Setter Property="Foreground" Value="#991B1B" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- 預覽表格：ContentControl 依 CurrentPreview 型別自動選擇 DataTemplate -->
                        <Border Grid.Row="1"
                                Style="{StaticResource Card}"
                                AllowDrop="True"
                                DragEnter="PreviewDropTarget_DragEnter"
                                DragOver="PreviewDropTarget_DragOver"
                                DragLeave="PreviewDropTarget_DragLeave"
                                Drop="PreviewDropTarget_Drop"
                                ClipToBounds="True"
                                Padding="0">
                            <Grid>
                                <ContentControl Content="{Binding CurrentPreview}"
                                                AutomationProperties.Name="操作預覽"
                                                Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                                </ContentControl>

                                <Border Padding="18">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="尚未產生預覽"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="載入圖片後將自動顯示預覽"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,6,0,0"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border IsHitTestVisible="False"
                                        Background="#EEF6FF"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="2"
                                        Visibility="{Binding IsPreviewDropTargetActive, Converter={StaticResource BoolToVis}}">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="放開以新增資料"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="支援拖曳檔案或資料夾"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,6,0,0"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ── 批次縮放 ─────────────────────────────────── -->
            <TabItem Header="批次縮放"
                     Style="{StaticResource ToolTabItem}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource Card}"
                            Padding="0"
                            ClipToBounds="True">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12,10"
                                        DataContext="{Binding ResizeTool}">

                                <!-- 縮放模式 -->
                                <TextBlock Text="縮放模式"
                                           Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,2,0,8">
                                    <RadioButton Content="倍率"
                                                 GroupName="ResizeMode"
                                                 Margin="0,0,14,0"
                                                 IsChecked="{Binding Mode,
                                                     Converter={StaticResource EnumToBoolConverter},
                                                     ConverterParameter=ScaleFactor}" />
                                    <RadioButton Content="絕對尺寸"
                                                 GroupName="ResizeMode"
                                                 IsChecked="{Binding Mode,
                                                     Converter={StaticResource EnumToBoolConverter},
                                                     ConverterParameter=Absolute}" />
                                </StackPanel>

                                <!-- 倍率模式區塊 -->
                                <StackPanel Visibility="{Binding Mode,
                                                Converter={StaticResource EnumToVisibilityConverter},
                                                ConverterParameter=ScaleFactor}">
                                    <TextBlock Text="縮放倍率"
                                               Style="{StaticResource FieldLabel}" />
                                    <Grid Margin="0,2,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="62" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                                AutomationProperties.Name="縮放倍率"
                                                Minimum="{Binding ScaleFactorSliderMinimum}"
                                                Maximum="{Binding ScaleFactorSliderMaximum}"
                                                SmallChange="{Binding ScaleFactorSliderSmallChange}"
                                                LargeChange="0.5"
                                                TickFrequency="{Binding ScaleFactorSliderSmallChange}"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding ScaleFactor,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding ScaleFactor,
                                                     UpdateSourceTrigger=PropertyChanged,
                                                     Converter={StaticResource ScaleFactorTextConverter}}"
                                                 TextAlignment="Right"
                                                 Margin="0" />
                                    </Grid>
                                </StackPanel>

                                <!-- 絕對尺寸模式區塊 -->
                                <StackPanel Visibility="{Binding Mode,
                                                Converter={StaticResource EnumToVisibilityConverter},
                                                ConverterParameter=Absolute}">
                                    <Grid Margin="0,4,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="目標寬度"
                                                       Style="{StaticResource FieldLabel}"
                                                       Margin="0,0,0,2" />
                                            <TextBox Text="{Binding TargetWidth, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="目標高度"
                                                       Style="{StaticResource FieldLabel}"
                                                       Margin="0,0,0,2" />
                                            <TextBox Text="{Binding TargetHeight, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="單邊填 0 時會依原始比例自動計算"
                                               Style="{StaticResource HintText}"
                                               Margin="0,2,0,4" />
                                    <CheckBox Content="維持原始比例"
                                              IsChecked="{Binding KeepAspectRatio}"
                                              Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- 輸出位置 -->
                                <TextBlock Text="輸出位置"
                                           Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,2,0,4">
                                    <RadioButton Content="覆寫原始"
                                                 GroupName="ResizeOutputMode"
                                                 Margin="0,0,14,0"
                                                 IsChecked="{Binding OutputMode,
                                                     Converter={StaticResource EnumToBoolConverter},
                                                     ConverterParameter=Overwrite}" />
                                    <RadioButton Content="指定資料夾"
                                                 GroupName="ResizeOutputMode"
                                                 IsChecked="{Binding OutputMode,
                                                     Converter={StaticResource EnumToBoolConverter},
                                                     ConverterParameter=TargetFolder}" />
                                </StackPanel>

                                <!-- 覆寫警示 -->
                                <Border Background="#FEF9C3"
                                        BorderBrush="#FDE047"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,6"
                                        Margin="0,4,0,4"
                                        Visibility="{Binding OutputMode,
                                            Converter={StaticResource EnumToVisibilityConverter},
                                            ConverterParameter=Overwrite}">
                                    <TextBlock Text="⚠ 覆寫模式：執行後原始圖片將被取代，無法還原"
                                               FontSize="11"
                                               Foreground="#92400E"
                                               TextWrapping="Wrap" />
                                </Border>

                                <!-- 縮放演算法 -->
                                <TextBlock Text="縮放演算法"
                                           Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ResamplerOptions}"
                                          SelectedItem="{Binding SelectedResampler}"
                                          Margin="0,2,0,2"
                                          Height="32">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ResamplerDisplayNameConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{Binding ResamplerHint}"
                                           Style="{StaticResource HintText}" />

                                <!-- 執行按鈕 -->
                                <Button Content="執行縮放"
                                        Style="{StaticResource ExecuteButton}"
                                        Command="{Binding ExecuteCommand}"
                                        HorizontalAlignment="Stretch" />

                                <!-- 執行進度區塊（執行中才顯示） -->
                                <Border Visibility="{Binding IsResizing, Converter={StaticResource BoolToVis}}"
                                        Background="#EFF6FF"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,10,0,0"
                                        Margin="0,10,0,0">
                                    <StackPanel>
                                        <ProgressBar Style="{StaticResource ResizeProgressBar}"
                                                     AutomationProperties.Name="縮放進度"
                                                     Value="{Binding ProgressCurrent}"
                                                     Maximum="{Binding ProgressTotal}" />
                                        <TextBlock Text="{Binding ProgressText}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,8" />
                                        <Button Content="取消縮放"
                                                Command="{Binding CancelCommand}"
                                                HorizontalAlignment="Stretch"
                                                Height="30"
                                                FontSize="12"
                                                Foreground="{StaticResource TextSecondary}"
                                                Background="White"
                                                BorderBrush="{StaticResource GhostBorderBrush}"
                                                BorderThickness="1" />
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- 右側：預覽區 -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 預覽摘要列：idle=灰 / ok=綠 / error=紅 -->
                        <Border Grid.Row="0"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="12,7"
                                Margin="0,0,0,6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background"  Value="#F8FAFC" />
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Style.Triggers>
                                        <!-- 有預覽且無錯誤：綠色 -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasPreview}"       Value="True" />
                                                <Condition Binding="{Binding HasPreviewErrors}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background"  Value="#F0FDF4" />
                                            <Setter Property="BorderBrush" Value="#86EFAC" />
                                        </MultiDataTrigger>
                                        <!-- 有錯誤：紅色 -->
                                        <DataTrigger Binding="{Binding HasPreviewErrors}" Value="True">
                                            <Setter Property="Background"  Value="#FEF2F2" />
                                            <Setter Property="BorderBrush" Value="#FECACA" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <TextBlock Text="{Binding PreviewSummary}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasPreview}"       Value="True" />
                                                    <Condition Binding="{Binding HasPreviewErrors}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="#166534" />
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding HasPreviewErrors}" Value="True">
                                                <Setter Property="Foreground" Value="#991B1B" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- 預覽表格：ContentControl 依 CurrentPreview 型別自動選擇 DataTemplate -->
                        <Border Grid.Row="1"
                                Style="{StaticResource Card}"
                                AllowDrop="True"
                                DragEnter="PreviewDropTarget_DragEnter"
                                DragOver="PreviewDropTarget_DragOver"
                                DragLeave="PreviewDropTarget_DragLeave"
                                Drop="PreviewDropTarget_Drop"
                                ClipToBounds="True"
                                Padding="0">
                            <Grid>
                                <ContentControl Content="{Binding CurrentPreview}"
                                                AutomationProperties.Name="操作預覽"
                                                Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                                </ContentControl>

                                <Border Padding="18">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="尚未產生預覽"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="載入圖片後將自動顯示預覽"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,6,0,0"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border IsHitTestVisible="False"
                                        Background="#EEF6FF"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="2"
                                        Visibility="{Binding IsPreviewDropTargetActive, Converter={StaticResource BoolToVis}}">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="放開以新增資料"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="支援拖曳檔案或資料夾"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,6,0,0"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ── 批次降噪 ─────────────────────────────────── -->
            <TabItem Header="批次降噪"
                     Style="{StaticResource ToolTabItem}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource Card}"
                            Padding="0"
                            ClipToBounds="True">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12,10"
                                        DataContext="{Binding DenoiseTool}">

                                <!-- 降噪模式 -->
                                <TextBlock Text="降噪模式"
                                           Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ModeOptions}"
                                          SelectedItem="{Binding SelectedMode}"
                                          Margin="0,2,0,2"
                                          Height="32">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource DenoiseModeDisplayNameConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{Binding SelectedModeHint}"
                                           Style="{StaticResource HintText}" />

                                <!-- 放大比較 -->
                                <Button Content="放大比較"
                                        Command="{Binding GenerateDenoisePreviewCommand}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,4" />
                                <TextBlock Text="產生預覽中…"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondary}"
                                           Visibility="{Binding IsGeneratingDenoisePreview,
                                               Converter={StaticResource BoolToVis}}"
                                           Margin="0,0,0,2" />
                                <TextBlock Text="{Binding DenoisePreviewErrorMessage}"
                                           FontSize="11"
                                           Foreground="{StaticResource DangerBrush}"
                                           TextWrapping="Wrap"
                                           ToolTip="{Binding DenoisePreviewErrorMessage}"
                                           Visibility="{Binding HasDenoisePreviewError,
                                               Converter={StaticResource BoolToVis}}"
                                           Margin="0,0,0,4" />

                                <!-- 覆寫警示（批次降噪固定覆寫原檔） -->
                                <Border Background="#FEF9C3"
                                        BorderBrush="#FDE047"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,6"
                                        Margin="0,4,0,4">
                                    <TextBlock Text="⚠ 執行後原始圖片將被降噪結果取代，無法還原"
                                               FontSize="11"
                                               Foreground="#92400E"
                                               TextWrapping="Wrap" />
                                </Border>

                                <!-- 執行按鈕 -->
                                <Button Content="執行降噪"
                                        Style="{StaticResource ExecuteButton}"
                                        Command="{Binding ExecuteCommand}"
                                        HorizontalAlignment="Stretch" />

                                <!-- 執行進度區塊（執行中才顯示） -->
                                <Border Visibility="{Binding IsDenoising, Converter={StaticResource BoolToVis}}"
                                        Background="#EFF6FF"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,10,0,0"
                                        Margin="0,10,0,0">
                                    <StackPanel>
                                        <ProgressBar Style="{StaticResource ResizeProgressBar}"
                                                     AutomationProperties.Name="降噪進度"
                                                     Value="{Binding ProgressCurrent}"
                                                     Maximum="{Binding ProgressTotal}" />
                                        <TextBlock Text="{Binding ProgressText}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,8" />
                                        <Button Content="取消降噪"
                                                Command="{Binding CancelCommand}"
                                                HorizontalAlignment="Stretch"
                                                Height="30"
                                                FontSize="12"
                                                Foreground="{StaticResource TextSecondary}"
                                                Background="White"
                                                BorderBrush="{StaticResource GhostBorderBrush}"
                                                BorderThickness="1" />
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- 右側：預覽區 -->
                    <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 預覽摘要列：idle=灰 / ok=綠 / error=紅 -->
                <Border Grid.Row="0"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,7"
                        Margin="0,0,0,6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"  Value="#F8FAFC" />
                            <Setter Property="BorderBrush" Value="#E2E8F0" />
                            <Style.Triggers>
                                <!-- 有預覽且無錯誤：綠色 -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasPreview}"       Value="True" />
                                        <Condition Binding="{Binding HasPreviewErrors}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background"  Value="#F0FDF4" />
                                    <Setter Property="BorderBrush" Value="#86EFAC" />
                                </MultiDataTrigger>
                                <!-- 有錯誤：紅色 -->
                                <DataTrigger Binding="{Binding HasPreviewErrors}" Value="True">
                                    <Setter Property="Background"  Value="#FEF2F2" />
                                    <Setter Property="BorderBrush" Value="#FECACA" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock Text="{Binding PreviewSummary}" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasPreview}"       Value="True" />
                                            <Condition Binding="{Binding HasPreviewErrors}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="#166534" />
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding HasPreviewErrors}" Value="True">
                                        <Setter Property="Foreground" Value="#991B1B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- 預覽表格：ContentControl 依 CurrentPreview 型別自動選擇 DataTemplate -->
                <Border Grid.Row="1"
                        Style="{StaticResource Card}"
                        AllowDrop="True"
                        DragEnter="PreviewDropTarget_DragEnter"
                        DragOver="PreviewDropTarget_DragOver"
                        DragLeave="PreviewDropTarget_DragLeave"
                        Drop="PreviewDropTarget_Drop"
                        ClipToBounds="True"
                        Padding="0">
                    <Grid>
                        <ContentControl Content="{Binding CurrentPreview}"
                                        AutomationProperties.Name="操作預覽"
                                        Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                        </ContentControl>

                        <Border Padding="18">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="尚未產生預覽"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="載入圖片後將自動顯示預覽"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,6,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border IsHitTestVisible="False"
                                Background="#EEF6FF"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="2"
                                Visibility="{Binding IsPreviewDropTargetActive, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="放開以新增資料"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="支援拖曳檔案或資料夾"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,6,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ── Log（Card 風格，可摺疊）──────────────────────── -->
        <Border Grid.Row="4"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Margin="0,10,0,0"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Log 標題列（點擊可摺疊） -->
                <DockPanel Grid.Row="0"
                           Background="{StaticResource HeaderBrush}"
                           LastChildFill="False">

                    <!-- 左側：箭頭 + LOG 標籤 -->
                    <Button DockPanel.Dock="Left"
                            Command="{Binding ToggleLogCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="14,7"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <StackPanel Orientation="Horizontal"
                                            Background="Transparent">
                                    <TextBlock x:Name="Arrow"
                                               Text="▼"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="9"
                                               VerticalAlignment="Center"
                                               Margin="6,1,8,0" />
                                    <TextBlock Text="LOG"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsLogExpanded}" Value="False">
                                        <Setter TargetName="Arrow" Property="Text" Value="▶" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Arrow" Property="Foreground"
                                                Value="{StaticResource TextPrimary}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 右側：清除按鈕（摺疊時隱藏） -->
                    <Button DockPanel.Dock="Right"
                            Content="清除"
                            Command="{Binding ClearLogCommand}"
                            Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVis}}"
                            Height="22"
                            Padding="10,0"
                            Margin="6,4"
                            FontSize="11"
                            Foreground="{StaticResource TextSecondary}"
                            Background="Transparent"
                            BorderBrush="{StaticResource GhostBorderBrush}"
                            BorderThickness="1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="3"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background"  Value="{StaticResource SurfaceSubtleBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground"  Value="{StaticResource TextPrimary}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DockPanel>

                <!-- 標題與內容分隔線 -->
                <Border Grid.Row="0"
                        VerticalAlignment="Bottom"
                        Height="1"
                        Background="{StaticResource CardBorderBrush}"
                        Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVis}}" />

                <!-- Log 訊息清單（摺疊時 Collapsed） -->
                <ListBox Grid.Row="1"
                         AutomationProperties.Name="操作紀錄"
                         Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVis}}"
                         Height="110"
                         ItemsSource="{Binding Logs}"
                         Background="{StaticResource SurfaceSubtleBrush}"
                         BorderThickness="0"
                         FontFamily="Cascadia Code, Consolas, monospace"
                         FontSize="11"
                         Foreground="{StaticResource TextSecondary}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background"       Value="Transparent" />
                            <Setter Property="BorderThickness"  Value="0" />
                            <Setter Property="Padding"          Value="12,2" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

    </Grid>
</Window>
