<Window x:Class="FrameFileTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FrameFileTool"
        Width="1120"
        Height="760"
        MinWidth="980"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="8,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="資料夾" FontWeight="SemiBold" Margin="0,0,8,0" />
            <TextBox Grid.Column="1"
                     Text="{Binding SelectedFolder, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="2"
                    Content="選擇資料夾"
                    Command="{Binding BrowseFolderCommand}" />
            <Button Grid.Column="3"
                    Content="掃描資料夾"
                    Command="{Binding ScanCommand}" />
        </Grid>

        <Border Grid.Row="1"
                BorderBrush="#D0D7DE"
                BorderThickness="0,0,0,1"
                Padding="0,10,0,12">
            <DockPanel LastChildFill="False">
                <TextBlock Text="檔案類型" FontWeight="SemiBold" Margin="0,0,8,0" />
                <CheckBox Content="png" IsChecked="{Binding IncludePng}" />
                <CheckBox Content="jpg" IsChecked="{Binding IncludeJpg}" />
                <CheckBox Content="jpeg" IsChecked="{Binding IncludeJpeg}" />
                <CheckBox Content="webp" IsChecked="{Binding IncludeWebp}" />
                <CheckBox Content="bmp" IsChecked="{Binding IncludeBmp}" />
                <CheckBox Content="包含子資料夾" IsChecked="{Binding IncludeSubfolders}" Margin="24,0,0,0" />
                <TextBlock Text="{Binding FileSummary}" Margin="24,0,0,0" Foreground="#57606A" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0"
                        SelectedIndex="{Binding SelectedToolIndex}"
                        TabStripPlacement="Left">
                <TabItem Header="抽幀功能">
                    <StackPanel Margin="14">
                        <TextBlock Text="每 N 張刪除 1 張" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="間隔 N" />
                        <TextBox Text="{Binding FrameDeleteInterval, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="預覽抽幀" Command="{Binding PreviewFrameDeleteCommand}" />
                            <Button Content="執行抽幀" Command="{Binding ExecuteFrameDeleteCommand}" />
                        </StackPanel>
                        <TextBlock Text="N = 3 時，會刪除排序後第 3、6、9... 張。"
                                   TextWrapping="Wrap"
                                   Foreground="#57606A"
                                   Margin="4,16,4,0" />
                    </StackPanel>
                </TabItem>
                <TabItem Header="批次改名">
                    <StackPanel Margin="14">
                        <TextBlock Text="批次改名" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="前綴" />
                        <TextBox Text="{Binding RenamePrefix, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="起始編號" Margin="0,8,0,0" />
                        <TextBox Text="{Binding RenameStartIndex, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="補零位數" Margin="0,8,0,0" />
                        <TextBox Text="{Binding RenamePadding, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="預覽改名" Command="{Binding PreviewRenameCommand}" />
                            <Button Content="執行改名" Command="{Binding ExecuteRenameCommand}" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <DataGrid Grid.Column="1"
                      ItemsSource="{Binding PreviewItems}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      Margin="14,0,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="序號" Binding="{Binding Index}" Width="70" />
                    <DataGridTextColumn Header="原始檔名" Binding="{Binding OriginalName}" Width="2*" />
                    <DataGridTextColumn Header="動作" Binding="{Binding Action}" Width="120" />
                    <DataGridTextColumn Header="新檔名 / 目標" Binding="{Binding TargetName}" Width="2*" />
                    <DataGridTextColumn Header="狀態" Binding="{Binding Status}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <GroupBox Grid.Row="3" Header="Log">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="清除"
                        Command="{Binding ClearLogCommand}"
                        Width="80" />
                <ListBox ItemsSource="{Binding Logs}" />
            </DockPanel>
        </GroupBox>
    </Grid>
</Window>
