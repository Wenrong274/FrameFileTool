<Window x:Class="FrameFileTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="影格整理工具"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Background="#EEF2F7"
        FontFamily="Segoe UI"
        Width="960"
        Height="660"
        MinWidth="820"
        MinHeight="560"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/MainWindowStyles.xaml" />
                <ResourceDictionary Source="Resources/PreviewTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── 頁首：產品識別與當前狀態 ─────────────────────── -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Padding="14,10"
                Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <Image DockPanel.Dock="Left"
                       Source="pack://application:,,,/Assets/AppIcon.png"
                       Width="34"
                       Height="34"
                       Margin="0,0,12,0" />

                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding FileSummary}"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12"
                           Margin="16,0,0,0" />

                <StackPanel>
                    <TextBlock Text="影格整理工具"
                               FontSize="17"
                               FontWeight="SemiBold" />
                    <TextBlock Text="FrameFileTool：序列圖片抽幀刪除、批次改名與批次縮放工具"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12"
                               Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── 更新通知：啟動後背景檢查 GitHub Release ─────── -->
        <Border Grid.Row="1"
                Background="#EFF6FF"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,0,0,10"
                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="關閉"
                        Command="{Binding DismissUpdateBannerCommand}"
                        Height="28"
                        Padding="10,0"
                        Margin="8,0,0,0"
                        FontSize="11"
                        Foreground="{StaticResource TextSecondary}"
                        Background="White"
                        BorderBrush="{StaticResource GhostBorderBrush}" />

                <Button DockPanel.Dock="Right"
                        Content="下載更新"
                        Command="{Binding GoToDownloadPageCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Height="28"
                        Padding="12,0"
                        FontSize="11" />

                <TextBlock Foreground="#1E3A8A"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis">
                    <Run Text="已有新版可下載：" />
                    <Run Text="{Binding LatestVersionText}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- ── 來源設定：資料夾與掃描選項集中在同一區 ───────── -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="14,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Text="來源資料夾"
                           FontWeight="SemiBold"
                           Margin="0,0,10,0" />

                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Margin="0,0,8,0"
                         Text="{Binding SelectedFolder, UpdateSourceTrigger=PropertyChanged}" />

                <Button Grid.Row="0"
                        Grid.Column="2"
                        Content="選擇資料夾"
                        Margin="0,0,6,0"
                        Command="{Binding BrowseFolderCommand}" />

                <Button Grid.Row="0"
                        Grid.Column="3"
                        Content="重新掃描"
                        Command="{Binding ScanFilesCommand}" />

                <Button Grid.Row="0"
                        Grid.Column="4"
                        Content="清空全部"
                        Margin="6,0,0,0"
                        Command="{Binding ClearFolderAndFilesCommand}" />

                <TextBlock Grid.Row="1"
                           Text="掃描格式"
                           FontWeight="SemiBold"
                           Margin="0,8,10,0" />

                <WrapPanel Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="4"
                           Margin="0,8,0,0"
                           VerticalAlignment="Center">
                    <CheckBox Content=".png"
                              Style="{StaticResource PillCheckBox}"
                              IsChecked="{Binding IncludePng}" />
                    <CheckBox Content=".jpg"
                              Style="{StaticResource PillCheckBox}"
                              IsChecked="{Binding IncludeJpg}" />
                    <CheckBox Content=".jpeg"
                              Style="{StaticResource PillCheckBox}"
                              IsChecked="{Binding IncludeJpeg}" />
                    <CheckBox Content=".webp"
                              Style="{StaticResource PillCheckBox}"
                              IsChecked="{Binding IncludeWebp}" />
                    <CheckBox Content=".bmp"
                              Style="{StaticResource PillCheckBox}"
                              IsChecked="{Binding IncludeBmp}" />
                    <CheckBox Content="包含子資料夾"
                              Style="{StaticResource PillCheckBox}"
                              MinWidth="110"
                              IsChecked="{Binding IncludeSubfolders}" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ── 主內容：左側工具 + 右側預覽 ─────────────────── -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左側：操作面板 -->
            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="0"
                    ClipToBounds="True">
                <TabControl SelectedIndex="{Binding SelectedToolIndex}"
                            AutomationProperties.Name="操作工具"
                            BorderThickness="0"
                            Background="Transparent">

                    <TabItem Header="抽幀刪除" Margin="0,0,6,1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="14,12">

                                <TextBlock Text="抽幀刪除"
                                           Style="{StaticResource SectionTitle}" />

                                <TextBlock Text="間隔"
                                           Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding FrameDeleteInterval, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="刪除會移至回收桶"
                                           Style="{StaticResource HintText}"
                                           Margin="0,0,0,6" />

                                <TextBlock Text="輸出模式"
                                           Style="{StaticResource FieldLabel}" />
                                <StackPanel Margin="0,2,0,4">
                                    <RadioButton Content="移到回收桶"
                                                 GroupName="FrameDeleteOutputMode"
                                                 Margin="0,0,0,4"
                                                 IsChecked="{Binding FrameDeleteOutputMode,
                                                     Converter={StaticResource EnumToBoolConverter},
                                                     ConverterParameter=DeleteToRecycleBin}" />
                                    <RadioButton Content="複製保留幀到指定資料夾"
                                                 GroupName="FrameDeleteOutputMode"
                                                 IsChecked="{Binding FrameDeleteOutputMode,
                                                     Converter={StaticResource EnumToBoolConverter},
                                                     ConverterParameter=CopyKeptToTargetFolder}" />
                                </StackPanel>

                                <TextBlock Text="* 預覽不含目標資料夾衝突偵測，將於執行時選擇資料夾並重新確認"
                                           Style="{StaticResource HintText}"
                                           Margin="0,0,0,4"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding FrameDeleteOutputMode,
                                               Converter={StaticResource EnumToVisibilityConverter},
                                               ConverterParameter=CopyKeptToTargetFolder}" />

                                <Button Content="{Binding FrameDeleteExecuteButtonText}"
                                        Style="{StaticResource ExecuteButton}"
                                        Command="{Binding ExecuteFrameDeleteCommand}"
                                        HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="批次改名" Margin="0,0,6,1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="14,12">

                                <TextBlock Text="批次改名"
                                           Style="{StaticResource SectionTitle}" />

                                <TextBlock Text="前綴"
                                           Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding RenamePrefix, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="起始編號"
                                           Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding RenameStartIndex, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="補零位數（0 = 不補零）"
                                           Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding RenamePadding, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="輸出模式"
                                           Style="{StaticResource FieldLabel}" />
                                <StackPanel Margin="0,2,0,4">
                                    <RadioButton Content="原地改名"
                                                 GroupName="RenameOutputMode"
                                                 Margin="0,0,0,4"
                                                 IsChecked="{Binding RenameOutputMode,
                                                     Converter={StaticResource EnumToBoolConverter},
                                                     ConverterParameter=RenameInPlace}" />
                                    <RadioButton Content="複製改名到指定資料夾"
                                                 GroupName="RenameOutputMode"
                                                 IsChecked="{Binding RenameOutputMode,
                                                     Converter={StaticResource EnumToBoolConverter},
                                                     ConverterParameter=CopyToTargetFolder}" />
                                </StackPanel>

                                <TextBlock Text="* 預覽不含目標資料夾衝突偵測，將於執行時選擇資料夾並重新確認"
                                           Style="{StaticResource HintText}"
                                           Margin="0,0,0,4"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding RenameOutputMode,
                                               Converter={StaticResource EnumToVisibilityConverter},
                                               ConverterParameter=CopyToTargetFolder}" />

                                <Button Content="{Binding RenameExecuteButtonText}"
                                        Style="{StaticResource ExecuteButton}"
                                        Command="{Binding ExecuteRenameCommand}"
                                        HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ── 批次縮放 Tab ────────────────────────── -->
                    <TabItem Header="批次縮放" Margin="0,0,6,1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="14,12">

                                <TextBlock Text="批次縮放"
                                           Style="{StaticResource SectionTitle}" />

                                <!-- 縮放模式 -->
                                <TextBlock Text="縮放模式"
                                           Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,2,0,8">
                                    <RadioButton Content="倍率"
                                                     GroupName="ResizeMode"
                                                     Margin="0,0,14,0"
                                                     IsChecked="{Binding ResizeMode,
                                                         Converter={StaticResource EnumToBoolConverter},
                                                     ConverterParameter=ScaleFactor}" />
                                    <RadioButton Content="絕對尺寸"
                                                 GroupName="ResizeMode"
                                                 IsChecked="{Binding ResizeMode,
                                                     Converter={StaticResource EnumToBoolConverter},
                                                     ConverterParameter=Absolute}" />
                                </StackPanel>

                                <!-- 倍率模式區塊 -->
                                <StackPanel Visibility="{Binding ResizeMode,
                                                Converter={StaticResource EnumToVisibilityConverter},
                                                ConverterParameter=ScaleFactor}">
                                    <TextBlock Text="縮放倍率"
                                               Style="{StaticResource FieldLabel}" />
                                    <Grid Margin="0,2,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="62" />
                                        </Grid.ColumnDefinitions>

                                        <Slider Grid.Column="0"
                                                AutomationProperties.Name="縮放倍率"
                                                Minimum="{Binding ScaleFactorSliderMinimum}"
                                                Maximum="{Binding ScaleFactorSliderMaximum}"
                                                SmallChange="{Binding ScaleFactorSliderSmallChange}"
                                                LargeChange="0.5"
                                                TickFrequency="{Binding ScaleFactorSliderSmallChange}"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding ScaleFactor,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0" />

                                        <TextBox Grid.Column="1"
                                                 Text="{Binding ScaleFactor,
                                                     UpdateSourceTrigger=PropertyChanged,
                                                     Converter={StaticResource ScaleFactorTextConverter}}"
                                                 TextAlignment="Right"
                                                 Margin="0" />
                                    </Grid>
                                </StackPanel>

                                <!-- 絕對尺寸模式區塊 -->
                                <StackPanel Visibility="{Binding ResizeMode,
                                                Converter={StaticResource EnumToVisibilityConverter},
                                                ConverterParameter=Absolute}">
                                    <TextBlock Text="目標寬度"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding TargetWidth, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="目標高度"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding TargetHeight, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="單邊填 0 時會依原始比例自動計算"
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,0,4" />

                                    <CheckBox Content="維持原始比例"
                                              IsChecked="{Binding KeepAspectRatio}"
                                              Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- 輸出位置 -->
                                <TextBlock Text="輸出位置"
                                           Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,2,0,4">
                                    <RadioButton Content="覆寫原始"
                                                 GroupName="ResizeOutputMode"
                                                 Margin="0,0,14,0"
                                                 IsChecked="{Binding ResizeOutputMode,
                                                     Converter={StaticResource EnumToBoolConverter},
                                                     ConverterParameter=Overwrite}" />
                                    <RadioButton Content="指定資料夾"
                                                 GroupName="ResizeOutputMode"
                                                 IsChecked="{Binding ResizeOutputMode,
                                                     Converter={StaticResource EnumToBoolConverter},
                                                     ConverterParameter=TargetFolder}" />
                                </StackPanel>

                                <!-- 覆寫警示 -->
                                <Border Background="#FEF9C3"
                                        BorderBrush="#FDE047"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,6"
                                        Margin="0,4,0,4"
                                        Visibility="{Binding ResizeOutputMode,
                                            Converter={StaticResource EnumToVisibilityConverter},
                                            ConverterParameter=Overwrite}">
                                    <TextBlock Text="⚠ 覆寫模式：執行後原始圖片將被取代，無法還原"
                                               FontSize="11"
                                               Foreground="#92400E"
                                               TextWrapping="Wrap" />
                                </Border>

                                <!-- 縮放演算法 -->
                                <TextBlock Text="縮放演算法"
                                           Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ResamplerOptions}"
                                          SelectedItem="{Binding SelectedResampler}"
                                          Margin="0,2,0,2"
                                          Height="32">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ResamplerDisplayNameConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{Binding ResamplerHint}"
                                           Style="{StaticResource HintText}" />

                                <!-- 降噪模式 -->
                                <TextBlock Text="降噪模式"
                                           Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,2,0,0">
                                    <RadioButton Content="關閉"
                                                 GroupName="DenoiseMode"
                                                 Margin="0,0,10,0"
                                                 IsChecked="{Binding SelectedDenoiseMode,
                                                     Converter={StaticResource EnumToBoolConverter},
                                                     ConverterParameter=Off}" />
                                    <RadioButton Content="保留細節"
                                                 GroupName="DenoiseMode"
                                                 Margin="0,0,10,0"
                                                 IsChecked="{Binding SelectedDenoiseMode,
                                                     Converter={StaticResource EnumToBoolConverter},
                                                     ConverterParameter=Detail}" />
                                    <RadioButton Content="標準"
                                                 GroupName="DenoiseMode"
                                                 Margin="0,0,10,0"
                                                 IsChecked="{Binding SelectedDenoiseMode,
                                                     Converter={StaticResource EnumToBoolConverter},
                                                     ConverterParameter=Standard}" />
                                    <RadioButton Content="強力"
                                                 GroupName="DenoiseMode"
                                                 IsChecked="{Binding SelectedDenoiseMode,
                                                     Converter={StaticResource EnumToBoolConverter},
                                                     ConverterParameter=Strong}" />
                                </StackPanel>

                                <!-- 強力模式警示 -->
                                <Border Background="#FEF9C3"
                                        BorderBrush="#FDE047"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,6"
                                        Margin="0,4,0,0"
                                        Visibility="{Binding IsStrongDenoiseModeSelected,
                                            Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="⚠ 強力模式可能使影像偏柔和，建議先用「產生預覽」確認效果"
                                               FontSize="11"
                                               Foreground="#92400E"
                                               TextWrapping="Wrap" />
                                </Border>

                                <!-- 降噪局部預覽 -->
                                <StackPanel Margin="0,6,0,0">
                                    <DockPanel Margin="0,0,0,4">
                                        <Button Content="產生預覽"
                                                DockPanel.Dock="Right"
                                                Command="{Binding GenerateDenoisePreviewCommand}"
                                                Padding="8,2"
                                                Height="26" />
                                        <TextBlock Text="各模式降噪效果比較（取第一張圖中央區塊）"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>

                                    <!-- 產生中 -->
                                    <TextBlock Text="產生預覽中…"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondary}"
                                               Visibility="{Binding IsGeneratingDenoisePreview,
                                                   Converter={StaticResource BoolToVis}}"
                                               Margin="0,2,0,4" />

                                    <!-- 錯誤訊息 -->
                                    <TextBlock Text="{Binding DenoisePreviewErrorMessage}"
                                               FontSize="11"
                                               Foreground="#DC2626"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasDenoisePreviewError,
                                                   Converter={StaticResource BoolToVis}}"
                                               Margin="0,2,0,4" />

                                    <!-- 三模式預覽圖（有預覽才顯示） -->
                                    <Grid Visibility="{Binding HasDenoisePreview,
                                              Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="保留細節"
                                                       FontSize="10"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondary}" />
                                            <Image Source="{Binding DenoisePreviewDetail}"
                                                   Height="100"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="標準"
                                                       FontSize="10"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondary}" />
                                            <Image Source="{Binding DenoisePreviewStandard}"
                                                   Height="100"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="強力"
                                                       FontSize="10"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondary}" />
                                            <Image Source="{Binding DenoisePreviewStrong}"
                                                   Height="100"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- 執行按鈕 -->
                                <Button Content="執行縮放"
                                        Style="{StaticResource ExecuteButton}"
                                        Command="{Binding ExecuteResizeCommand}"
                                        HorizontalAlignment="Stretch" />

                                <!-- ── 執行進度區塊（執行中才顯示）──── -->
                                <Border Visibility="{Binding IsResizing, Converter={StaticResource BoolToVis}}"
                                        Background="#EFF6FF"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,10,0,0"
                                        Margin="0,10,0,0">
                                    <StackPanel>

                                        <!-- 進度條 -->
                                        <ProgressBar Style="{StaticResource ResizeProgressBar}"
                                                     AutomationProperties.Name="縮放進度"
                                                     Value="{Binding ResizeProgressCurrent}"
                                                     Maximum="{Binding ResizeProgressTotal}" />

                                        <!-- 目前處理的檔名 -->
                                        <TextBlock Text="{Binding ResizeProgressText}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,8" />

                                        <!-- 取消按鈕 -->
                                        <Button Content="取消縮放"
                                                Command="{Binding CancelResizeCommand}"
                                                HorizontalAlignment="Stretch"
                                                Height="30"
                                                FontSize="12"
                                                Foreground="{StaticResource TextSecondary}"
                                                Background="White"
                                                BorderBrush="{StaticResource GhostBorderBrush}"
                                                BorderThickness="1" />
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
            </Border>

            <!-- 右側：預覽區 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 預覽摘要列：idle=灰 / ok=綠 / error=紅 -->
                <Border Grid.Row="0"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,7"
                        Margin="0,0,0,6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"  Value="#F8FAFC" />
                            <Setter Property="BorderBrush" Value="#E2E8F0" />
                            <Style.Triggers>
                                <!-- 有預覽且無錯誤：綠色 -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasPreview}"       Value="True" />
                                        <Condition Binding="{Binding HasPreviewErrors}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background"  Value="#F0FDF4" />
                                    <Setter Property="BorderBrush" Value="#86EFAC" />
                                </MultiDataTrigger>
                                <!-- 有錯誤：紅色 -->
                                <DataTrigger Binding="{Binding HasPreviewErrors}" Value="True">
                                    <Setter Property="Background"  Value="#FEF2F2" />
                                    <Setter Property="BorderBrush" Value="#FECACA" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock Text="{Binding PreviewSummary}" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasPreview}"       Value="True" />
                                            <Condition Binding="{Binding HasPreviewErrors}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="#166534" />
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding HasPreviewErrors}" Value="True">
                                        <Setter Property="Foreground" Value="#991B1B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- 預覽表格：ContentControl 依 CurrentPreview 型別自動選擇 DataTemplate -->
                <Border Grid.Row="1"
                        Style="{StaticResource Card}"
                        AllowDrop="True"
                        DragEnter="PreviewDropTarget_DragEnter"
                        DragOver="PreviewDropTarget_DragOver"
                        DragLeave="PreviewDropTarget_DragLeave"
                        Drop="PreviewDropTarget_Drop"
                        ClipToBounds="True"
                        Padding="0">
                    <Grid>
                        <ContentControl Content="{Binding CurrentPreview}"
                                        AutomationProperties.Name="操作預覽"
                                        Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                        </ContentControl>

                        <Border Padding="18">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="尚未產生預覽"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="載入圖片後將自動顯示預覽"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,6,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border IsHitTestVisible="False"
                                Background="#EEF6FF"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="2"
                                Visibility="{Binding IsPreviewDropTargetActive, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="放開以新增資料"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="支援拖曳檔案或資料夾"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,6,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ── Log（Card 風格，可摺疊）──────────────────────── -->
        <Border Grid.Row="4"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Margin="0,10,0,0"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Log 標題列（點擊可摺疊） -->
                <DockPanel Grid.Row="0"
                           Background="{StaticResource HeaderBrush}"
                           LastChildFill="False">

                    <!-- 左側：箭頭 + LOG 標籤 -->
                    <Button DockPanel.Dock="Left"
                            Command="{Binding ToggleLogCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="14,7"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <StackPanel Orientation="Horizontal"
                                            Background="Transparent">
                                    <TextBlock x:Name="Arrow"
                                               Text="▼"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="9"
                                               VerticalAlignment="Center"
                                               Margin="6,1,8,0" />
                                    <TextBlock Text="LOG"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsLogExpanded}" Value="False">
                                        <Setter TargetName="Arrow" Property="Text" Value="▶" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Arrow" Property="Foreground"
                                                Value="{StaticResource TextPrimary}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 右側：清除按鈕（摺疊時隱藏） -->
                    <Button DockPanel.Dock="Right"
                            Content="清除"
                            Command="{Binding ClearLogCommand}"
                            Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVis}}"
                            Height="22"
                            Padding="10,0"
                            Margin="6,4"
                            FontSize="11"
                            Foreground="{StaticResource TextSecondary}"
                            Background="Transparent"
                            BorderBrush="{StaticResource GhostBorderBrush}"
                            BorderThickness="1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="3"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background"  Value="{StaticResource SurfaceSubtleBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground"  Value="{StaticResource TextPrimary}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DockPanel>

                <!-- 標題與內容分隔線 -->
                <Border Grid.Row="0"
                        VerticalAlignment="Bottom"
                        Height="1"
                        Background="{StaticResource CardBorderBrush}"
                        Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVis}}" />

                <!-- Log 訊息清單（摺疊時 Collapsed） -->
                <ListBox Grid.Row="1"
                         AutomationProperties.Name="操作紀錄"
                         Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVis}}"
                         Height="110"
                         ItemsSource="{Binding Logs}"
                         Background="{StaticResource SurfaceSubtleBrush}"
                         BorderThickness="0"
                         FontFamily="Cascadia Code, Consolas, monospace"
                         FontSize="11"
                         Foreground="{StaticResource TextSecondary}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background"       Value="Transparent" />
                            <Setter Property="BorderThickness"  Value="0" />
                            <Setter Property="Padding"          Value="12,2" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

    </Grid>
</Window>
